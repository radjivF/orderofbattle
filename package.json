{
  "name": "orderofbattle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e.config.ts",
    "e2e:log": "mkdir -p reports && playwright test -c e2e.config.ts 2>&1 | tee reports/e2e-last-run.txt",
    "e2e:ui": "playwright test -c e2e.config.ts --ui",
    "e2e:local": "PLAYWRIGHT_BROWSERS_PATH=$HOME/Library/Caches/ms-playwright playwright test -c e2e.config.ts",
    "smoke:magic": "tsx scripts/smoke-magic-binds.ts",
    "verify": "yarn lint && yarn test && yarn build",
    "sentry:prod-watch": "tsx scripts/sentry-prod-watch.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.72.0",
    "gsap": "^3.15.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "24.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@1.22.22"
}
